{
  "name": "cockpit-procedure-trainer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cpt/web dev",
    "build": "pnpm --filter @cpt/web build",
    "lint": "eslint . && stylelint \"{apps,packages}/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc -p tools",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:e2e": "pnpm --filter @cpt/web exec playwright test",
    "test:perf": "pnpm --filter @cpt/web test:perf"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
